{
  "uid": "sandbox-golden-signals",
  "title": "Sandbox / Golden signals",
  "description": "Latency, traffic, errors, saturation (Google SRE) + SLO burn rate, dependencies and logs for one service.",
  "tags": ["sandbox", "slo", "golden-signals"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "app",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(http_server_request_duration_seconds_count{namespace=\"sandbox\"}, app)",
        "query": { "query": "label_values(http_server_request_duration_seconds_count{namespace=\"sandbox\"}, app)", "refId": "app" },
        "refresh": 2,
        "current": { "text": "orders-api", "value": "orders-api" },
        "includeAll": false,
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "type": "row", "title": "Golden signals: $app", "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "type": "stat", "title": "Traffic (req/s, 5m)",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum(rate(http_server_request_duration_seconds_count{namespace=\"sandbox\", app=\"$app\", http_route=~\".+\", http_route!~\"/health.*\"}[5m]))" }
      ]
    },
    {
      "type": "stat", "title": "Errors (5xx share, 5m)",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit", "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.05 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "(sum(rate(http_server_request_duration_seconds_count{namespace=\"sandbox\", app=\"$app\", http_route=~\".+\", http_route!~\"/health.*\", http_response_status_code=~\"5..\"}[5m])) or vector(0)) / sum(rate(http_server_request_duration_seconds_count{namespace=\"sandbox\", app=\"$app\", http_route=~\".+\", http_route!~\"/health.*\"}[5m]))" }
      ]
    },
    {
      "type": "stat", "title": "Latency p99 (5m)",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s", "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.25 }, { "color": "red", "value": 1 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"sandbox\", app=\"$app\", http_route=~\".+\", http_route!~\"/health.*\"}[5m])))" }
      ]
    },
    {
      "type": "stat", "title": "SLO burn rate (1h, x budget)",
      "description": "1 = spending the error budget exactly on schedule for a 99% SLO. 14.4 over 1h pages.",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "none", "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 14.4 } ] }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "slo:sli_error:ratio_rate1h{slo=\"$app\"} / 0.01" }
      ]
    },
    {
      "type": "timeseries", "title": "Traffic by route and status",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (http_request_method, http_route, http_response_status_code) (rate(http_server_request_duration_seconds_count{namespace=\"sandbox\", app=\"$app\", http_route=~\".+\", http_route!~\"/health.*\"}[$__rate_interval]))", "legendFormat": "{{http_request_method}} {{http_route}} {{http_response_status_code}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Latency percentiles",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"sandbox\", app=\"$app\", http_route=~\".+\", http_route!~\"/health.*\"}[$__rate_interval])))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"sandbox\", app=\"$app\", http_route=~\".+\", http_route!~\"/health.*\"}[$__rate_interval])))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{namespace=\"sandbox\", app=\"$app\", http_route=~\".+\", http_route!~\"/health.*\"}[$__rate_interval])))", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries", "title": "SLO: share of bad requests (5xx or too slow)",
      "gridPos": { "x": 0, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "slo:sli_error:ratio_rate5m{slo=\"$app\"}", "legendFormat": "5m" },
        { "refId": "B", "expr": "slo:sli_error:ratio_rate1h{slo=\"$app\"}", "legendFormat": "1h" },
        { "refId": "C", "expr": "slo:sli_error:ratio_rate6h{slo=\"$app\"}", "legendFormat": "6h" },
        { "refId": "D", "expr": "vector(0.144)", "legendFormat": "fast-burn threshold (14.4 x 1%)" }
      ]
    },
    {
      "type": "timeseries", "title": "Saturation: CPU used / CPU limit",
      "gridPos": { "x": 12, "y": 13, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"sandbox\", pod=~\"$app-.*\", container!=\"\", container!=\"POD\"}[$__rate_interval])) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"sandbox\", pod=~\"$app-.*\", resource=\"cpu\"})", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Saturation: memory working set / memory limit",
      "gridPos": { "x": 0, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"sandbox\", pod=~\"$app-.*\", container!=\"\", container!=\"POD\"}) / sum by (pod) (kube_pod_container_resource_limits{namespace=\"sandbox\", pod=~\"$app-.*\", resource=\"memory\"})", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "type": "timeseries", "title": "Container restarts (increase over 15m)",
      "gridPos": { "x": 12, "y": 21, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 0 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (pod) (increase(kube_pod_container_status_restarts_total{namespace=\"sandbox\", pod=~\"$app-.*\"}[15m]))", "legendFormat": "{{pod}}" }
      ]
    },
    {
      "type": "row", "title": "Dependencies", "collapsed": false,
      "gridPos": { "x": 0, "y": 29, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries", "title": "PostgreSQL: up and active connections",
      "gridPos": { "x": 0, "y": 30, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "max(pg_up{namespace=\"sandbox\"}) or vector(0)", "legendFormat": "pg_up" },
        { "refId": "B", "expr": "sum(pg_stat_activity_count{namespace=\"sandbox\", datname=\"orders\"})", "legendFormat": "connections to orders" }
      ]
    },
    {
      "type": "timeseries", "title": "Edge (Traefik): 5xx per backend",
      "gridPos": { "x": 12, "y": 30, "w": 12, "h": 7 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "sum by (service, code) (rate(traefik_service_requests_total{code=~\"5..\"}[$__rate_interval]))", "legendFormat": "{{service}} {{code}}" }
      ]
    },
    {
      "type": "row", "title": "Logs", "collapsed": false,
      "gridPos": { "x": 0, "y": 37, "w": 24, "h": 1 }
    },
    {
      "type": "logs", "title": "Warnings and errors: $app",
      "gridPos": { "x": 0, "y": 38, "w": 24, "h": 10 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [
        { "refId": "A", "expr": "{namespace=\"sandbox\", app=\"$app\", level=~\"Warning|Error|Critical\"}" }
      ]
    }
  ]
}
